# sandbox-runtime 配置：workspace-write 策略
#
# 将该文件复制到你的项目下作为 .sandbox.toml 并按需调整路径。
# 沙箱对整个文件系统授予读权限，仅对指定路径授予写权限。

[filesystem]
# Workspace-write：完全读访问，仅向指定路径授予写权限
policy = "workspace"

# 允许写入的路径（除工作目录之外）
# 支持 ~ 展开为主目录
allow_write = [".", "/tmp"]

[network]
# 在 workspace-write 模式下，网络访问默认关闭
enabled = false

[timeout]
default_secs = 30
max_secs = 300